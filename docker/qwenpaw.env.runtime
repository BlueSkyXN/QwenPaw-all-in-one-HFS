# Non-secret runtime defaults for QwenPaw HFS.
# Secrets must be supplied via Hugging Face Space Settings or local env.

PORT=${PORT:-7860}
QWENPAW_PORT=${QWENPAW_PORT:-8088}
QWENPAW_WORKING_DIR=${QWENPAW_WORKING_DIR:-/data/qwenpaw/working}
QWENPAW_SECRET_DIR=${QWENPAW_SECRET_DIR:-/data/qwenpaw/secrets}
QWENPAW_BACKUP_DIR=${QWENPAW_BACKUP_DIR:-/data/qwenpaw/backups}
QWENPAW_DISABLED_CHANNELS=${QWENPAW_DISABLED_CHANNELS:-imessage}
QWENPAW_RUNNING_IN_CONTAINER=${QWENPAW_RUNNING_IN_CONTAINER:-1}
QWENPAW_TELEMETRY_OPT_OUT=${QWENPAW_TELEMETRY_OPT_OUT:-1}
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-/usr/bin/chromium}
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=${PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD:-1}
ADMIN_ENABLED=${ADMIN_ENABLED:-false}
ADMIN_CSRF_TOKEN=${ADMIN_CSRF_TOKEN:-}
OPS_SESSION_TTL_SECONDS=${OPS_SESSION_TTL_SECONDS:-3600}
OPS_COOKIE_SECURE=${OPS_COOKIE_SECURE:-auto}
