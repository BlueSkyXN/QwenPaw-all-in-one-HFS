# HFS value-ledger template. Copy to the ignored .env and fill values locally.
# .env.local remains an ignored compatibility file for local Docker/run workflows.
# Do not place real credentials in either template or in Git.

# Local-only control, deployment, and smoke values. Never sync these to Space Settings.
GH_TOKEN=
HF_TOKEN=
GH_REPO=
HF_SPACE_ID=
HF_SPACE_URL=
HF_PUBLIC_URL=
HF_STORAGE_BUCKET=
SMOKE_BASE_URL=
QWENPAW_ADMIN_USERNAME=
QWENPAW_ADMIN_PASSWORD=
ADMIN_EXPECTED_ENABLED=false
ADMIN_SMOKE_ACTIONS=false

# Hugging Face Space Secrets.
OPS_TOKEN=
ADMIN_TOKEN=
ADMIN_CSRF_TOKEN=
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Hugging Face Space Variables.
PORT=7860
QWENPAW_PORT=8088
QWENPAW_WORKING_DIR=/data/qwenpaw/working
QWENPAW_SECRET_DIR=/data/qwenpaw/secrets
QWENPAW_BACKUP_DIR=/data/qwenpaw/backups
QWENPAW_DISABLED_CHANNELS=imessage
QWENPAW_AUTH_ENABLED=true
QWENPAW_TELEMETRY_OPT_OUT=1
ADMIN_ENABLED=false
QWENPAW_OPS_PORT=8081
QWENPAW_ADMIN_PORT=8082
QWENPAW_OPS_LOG_DIR=/data/var/logs
QWENPAW_ADMIN_AUDIT_LOG=/data/var/logs/admin-audit.jsonl
OPS_SESSION_TTL_SECONDS=3600
OPS_COOKIE_SECURE=auto
